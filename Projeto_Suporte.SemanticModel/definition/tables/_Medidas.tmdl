table _Medidas
	lineageTag: ede66f83-0dd6-41a5-a562-a530e9a55ee9

	measure 'Total Chamados' = COUNTROWS('dw fato_chamados')
		formatString: #,0
		displayFolder: 1 Volume
		lineageTag: 108d3ae9-6853-4ab7-9176-d5600ff7f89e

	measure MTTR = AVERAGE('dw fato_chamados'[tempo_resolucao])
		formatString: 0.0" h"
		displayFolder: 3 Tempo
		lineageTag: 70a3a405-70e1-4f65-8aa4-7ea615c614b5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% SLA Resolucao' =
			DIVIDE(
			    CALCULATE([Total Chamados], 'dw fato_chamados'[sla_resolucao_ok] = 1),
			    CALCULATE([Total Chamados], NOT(ISBLANK('dw fato_chamados'[sla_resolucao_ok])))
			)
		formatString: 0.0%
		displayFolder: 2 SLA
		lineageTag: 5cc5bd42-bd6d-4e74-9e02-6a3eb027a01f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Fechados pela data de fechamento. Usar só no gráfico de evolução no tempo.
	measure 'Fechados no Período' =
			
			CALCULATE(
			    [Total Chamados],
			    USERELATIONSHIP('dw fato_chamados'[id_data_fechamento], 'dw dim_calendario'[id_data]),
			    NOT(ISBLANK('dw fato_chamados'[data_fechamento]))
			)
		formatString: #,0
		displayFolder: 1 Volume
		lineageTag: 181c5cd7-21dc-4bb1-bdf4-22662c19a028

	/// Duplicada do Backlog (mesmo valor, lógica por data). Oculta; excluir depois de confirmar que nenhum visual usa.
	measure 'Chamados em Aberto' = ```
			
			CALCULATE(
			    [Total Chamados], 
			    ISBLANK('dw fato_chamados'[data_fechamento])
			)
			```
		formatString: 0
		isHidden
		displayFolder: 5 Operacional
		lineageTag: f3e55c01-3ee7-41b5-811f-8ae9a86fb06b

	measure 'Carga Média por Analista' =
			
			DIVIDE([Total Chamados], DISTINCTCOUNT('dw dim_analista'[id_analista]))
		formatString: #,0
		displayFolder: 4 Equipe
		lineageTag: 69ac1e93-c2f3-4175-a0fc-3d1a134638ae

	measure 'MTTR Equipe' =
			
			CALCULATE([MTTR], REMOVEFILTERS('dw dim_analista'))
		formatString: 0.0" h"
		displayFolder: 3 Tempo
		lineageTag: 4c7a3d58-95ad-40e6-99d4-28057840c5fb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Backlog =
			
			CALCULATE([Total Chamados], 'dw fato_chamados'[status] <> "FECHADO")
		formatString: #,0
		displayFolder: 1 Volume
		lineageTag: c95d9707-1871-4376-811d-e8a45d8d7d1c

	measure 'Chamados Críticos' =
			
			CALCULATE([Total Chamados], 'dw fato_chamados'[prioridade] = "CRÍTICA")
		formatString: #,0
		displayFolder: 5 Operacional
		lineageTag: 3bdfc31d-7a2e-4de2-9f58-bf1932e802f9

	measure 'Diferença MTTR vs Equipe' = [MTTR] - [MTTR Equipe]
		formatString: +0.0" h";-0.0" h";0.0" h"
		displayFolder: 3 Tempo
		lineageTag: 23b0b98b-87a7-422b-ae45-0503615e1d7e

	measure 'Média de Chamados por Dia' =
			
			AVERAGEX(VALUES('dw dim_calendario'[data]), [Total Chamados])
		formatString: #,0
		displayFolder: 1 Volume
		lineageTag: 93de86b8-2cc0-44a2-9cd4-5b85961dcc0f

	measure '% SLA Resposta' =
			
			DIVIDE(
			    CALCULATE([Total Chamados], 'dw fato_chamados'[sla_resposta_ok] = 1),
			    [Total Chamados]
			)
		formatString: 0.0%
		displayFolder: 2 SLA
		lineageTag: d6753652-6af0-4640-b0f3-afbdbaa42a6b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Chamados com status FECHADO, entre os chamados abertos no período selecionado. Total = Fechados + Backlog.
	measure Fechados = CALCULATE([Total Chamados], 'dw fato_chamados'[status] = "FECHADO")
		formatString: #,0
		displayFolder: 1 Volume
		lineageTag: 00f8a71a-8773-47ba-9a21-2fa74e89bd07

	/// Fechados dividido pelo Total de Chamados.
	measure '% Fechados' = DIVIDE([Fechados], [Total Chamados])
		formatString: 0.0%
		displayFolder: 1 Volume
		lineageTag: 0cbaf50d-ac07-4db3-8ac7-48d10f34b897

	/// Backlog dividido pelo Total de Chamados.
	measure '% Backlog' = DIVIDE([Backlog], [Total Chamados])
		formatString: 0.0%
		displayFolder: 1 Volume
		lineageTag: de84aea5-d4b9-4f38-b748-c90f2188ac11

	/// Chamados por analista considerando toda a equipe visível ao usuário (a RLS continua valendo).
	measure 'Carga Média da Equipe' =
			DIVIDE(
			    CALCULATE([Total Chamados], REMOVEFILTERS('dw dim_analista')),
			    CALCULATE(DISTINCTCOUNT('dw dim_analista'[id_analista]), REMOVEFILTERS('dw dim_analista'))
			)
		formatString: #,0
		displayFolder: 4 Equipe
		lineageTag: 6b9365e5-330d-4445-b492-787606c818b6

	/// Quanto a carga do analista (ou do grupo) está acima ou abaixo da média da equipe.
	measure 'Carga vs Equipe (%)' = DIVIDE([Carga Média por Analista], [Carga Média da Equipe]) - 1
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 4 Equipe
		lineageTag: f990dee9-3440-4152-8e93-7cbd6683d751

	/// Chamados de prioridade CRÍTICA que ainda não foram fechados.
	measure 'Backlog Crítico' = CALCULATE([Backlog], 'dw fato_chamados'[prioridade] = "CRÍTICA")
		formatString: #,0
		displayFolder: 5 Operacional
		lineageTag: e76dcbe6-6e37-4965-8b9d-43548d0e7f89

	/// Chamados fechados que estouraram a meta de resolução.
	measure 'Violações SLA Resolução' =
			CALCULATE(
			    [Total Chamados],
			    'dw fato_chamados'[sla_resolucao_ok] = 0,
			    NOT(ISBLANK('dw fato_chamados'[sla_resolucao_ok]))
			)
		formatString: #,0
		displayFolder: 2 SLA
		lineageTag: ec4e17bc-1bcb-42b7-a46a-283a7f773994

	/// Chamados que estouraram a meta de primeira resposta.
	measure 'Violações SLA Resposta' = CALCULATE([Total Chamados], 'dw fato_chamados'[sla_resposta_ok] = 0)
		formatString: #,0
		displayFolder: 2 SLA
		lineageTag: 1c7b9c26-4910-4864-924e-8f1a33b1361b

	/// Período coberto pelos chamados no contexto de filtro (data de abertura). Ex.: 01/01 a 29/06/2024. Texto só para exibição.
	measure 'Período Avaliado' =
			VAR _ini = MIN('dw fato_chamados'[data_abertura])
			VAR _fim = MAX('dw fato_chamados'[data_abertura])
			VAR _mesmoAno = YEAR(_ini) = YEAR(_fim)
			VAR _txtIni =
			    FORMAT(DAY(_ini), "00") & "/" & FORMAT(MONTH(_ini), "00")
			        & IF(_mesmoAno, "", "/" & YEAR(_ini))
			VAR _txtFim =
			    FORMAT(DAY(_fim), "00") & "/" & FORMAT(MONTH(_fim), "00") & "/" & YEAR(_fim)
			RETURN
			    IF(ISBLANK(_ini), BLANK(), _txtIni & " a " & _txtFim)
		displayFolder: 1 Volume
		lineageTag: ff06d44a-7b37-4a48-8791-2a0beae9cf49

	/// Dias corridos entre a primeira e a última abertura no contexto de filtro, inclusive. Usada no tooltip do card executivo (Deneb).
	measure 'Dias no Período' =
			VAR _ini = MIN('dw fato_chamados'[data_abertura])
			VAR _fim = MAX('dw fato_chamados'[data_abertura])
			RETURN
			    IF(NOT ISBLANK(_ini), DATEDIFF(_ini, _fim, DAY) + 1)
		formatString: #,0
		displayFolder: 1 Volume
		lineageTag: 2d612098-9f2e-47d0-85bd-bcb3da742bdf

	/// Chave numérica aaaamm do mês no contexto de filtro (ex.: 202406). Usada só para ordenar a série mensal no card executivo (Deneb), evitando coluna numérica que o Power BI somaria.
	measure 'Chave Mês' =
			IF(
			    NOT ISBLANK([Total Chamados]),
			    MAX('dw dim_calendario'[ano]) * 100 + MAX('dw dim_calendario'[mes])
			)
		formatString: 0
		displayFolder: 6 Auxiliares de Visuais
		lineageTag: be04e8b3-8838-4456-bbd3-0ac070cd0d66

	/// HTML do card KPI Total de Chamados (tema escuro azul). Aditiva.
	measure 'HTML KPI Total Chamados' =
			VAR _valor = [Total Chamados]
			VAR _txt = IF ( ISBLANK ( _valor ), "—", FORMAT ( _valor, "#,0", "pt-BR" ) )
			VAR _sub = IF ( ISBLANK ( [Período Avaliado] ), "Sem dados no período", [Período Avaliado] )
			VAR _cor = "#C8102E"
			VAR _rotulo = "Total de Chamados"
			VAR _css =
			    "<style>
			    *{box-sizing:border-box;}
			    html,body{margin:0 !important;padding:0 !important;width:100%;height:100%;background:transparent;overflow:hidden;}
			    .card{position:fixed;left:0;top:0;right:0;bottom:0;width:100vw;height:100vh;margin:0;display:flex;flex-direction:column;justify-content:center;
			          padding:0 3% 0 7%;border:1px solid transparent;border-radius:16px;overflow:hidden;
			          background-origin:border-box;background-clip:padding-box,padding-box,border-box;
			          background-image:radial-gradient(120% 100% at 0% 0%," & _cor & "00 0%,transparent 60%),linear-gradient(160deg,#FFFFFF 0%,#FFFFFF 100%),linear-gradient(135deg,#ECDCDD 0%,#ECDCDD 100%);
			          box-shadow:0 1px 3px rgba(120,30,40,.06);
			          font-family:'Segoe UI',Arial,sans-serif;}
			    .bar{position:absolute;left:0;top:20%;bottom:20%;width:4px;border-radius:0 4px 4px 0;background:" & _cor & ";box-shadow:none;}
			    .label{color:#7D6669;font-size:clamp(13px,min(11vh,6.2vw),25px);font-weight:400;letter-spacing:.01em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
			    .value{color:#2B1518;font-size:clamp(24px,min(32vh,16vw),80px);font-weight:700;line-height:1.05;margin:.1em 0 .06em;
			           letter-spacing:-.02em;font-variant-numeric:tabular-nums;white-space:nowrap;}
			    .period{color:#A8979A;font-size:clamp(12px,min(10vh,5.6vw),21px);font-weight:400;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
			    </style>"
			RETURN
			    _css
			        & "<div class='card' role='img' aria-label='" & _rotulo & ": " & _txt & ", " & _sub & "'>"
			        & "<div class='bar'></div>"
			        & "<div class='label'>" & _rotulo & "</div>"
			        & "<div class='value'>" & _txt & "</div>"
			        & "<div class='period'>" & _sub & "</div>"
			        & "</div>"
		displayFolder: Página 1 - Visão Executiva
		lineageTag: 054c9c4e-4b0d-4ab0-b130-9db155692aee

	/// HTML do card KPI Chamados Fechados (tema escuro azul). Aditiva.
	measure 'HTML KPI Fechados' =
			VAR _valor = [Fechados]
			VAR _txt = IF ( ISBLANK ( _valor ), "—", FORMAT ( _valor, "#,0", "pt-BR" ) )
			VAR _sub = IF ( ISBLANK ( [% Fechados] ), "Sem dados no período", FORMAT ( [% Fechados], "0.0%", "pt-BR" ) & " do total" )
			VAR _cor = "#C8102E"
			VAR _rotulo = "Chamados Fechados"
			VAR _css =
			    "<style>
			    *{box-sizing:border-box;}
			    html,body{margin:0 !important;padding:0 !important;width:100%;height:100%;background:transparent;overflow:hidden;}
			    .card{position:fixed;left:0;top:0;right:0;bottom:0;width:100vw;height:100vh;margin:0;display:flex;flex-direction:column;justify-content:center;
