			          background-image:radial-gradient(120% 100% at 0% 0%," & _cor & "00 0%,transparent 60%),linear-gradient(160deg,#FFFFFF 0%,#FFFFFF 100%),linear-gradient(135deg,#ECDCDD 0%,#ECDCDD 100%);
			          box-shadow:0 1px 3px rgba(120,30,40,.06);
			          font-family:'Segoe UI',Arial,sans-serif;}
			    .bar{position:absolute;left:0;top:20%;bottom:20%;width:4px;border-radius:0 4px 4px 0;background:" & _cor & ";box-shadow:none;}
			    .label{color:#7D6669;font-size:clamp(13px,min(11vh,6.2vw),25px);font-weight:400;letter-spacing:.01em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
			    .value{color:#2B1518;font-size:clamp(24px,min(32vh,16vw),80px);font-weight:700;line-height:1.05;margin:.1em 0 .06em;
			           letter-spacing:-.02em;font-variant-numeric:tabular-nums;white-space:nowrap;}
			    .period{color:#A8979A;font-size:clamp(12px,min(10vh,5.6vw),21px);font-weight:400;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
			    </style>"
			RETURN
			    _css
			        & "<div class='card' role='img' aria-label='" & _rotulo & ": " & _txt & ", " & _sub & "'>"
			        & "<div class='bar'></div>"
			        & "<div class='label'>" & _rotulo & "</div>"
			        & "<div class='value'>" & _txt & "</div>"
			        & "<div class='period'>" & _sub & "</div>"
			        & "</div>"
		displayFolder: Página 1 - Visão Executiva
		lineageTag: 974856dc-f866-4010-a426-67d5d040c33a

